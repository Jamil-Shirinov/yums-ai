OPENAI_API_KEY=sk-your-key

# Any long random string. You may generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-random-string

# From a "Web application" OAuth client in Google Cloud Console. See the README for more details.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Local development only. Google's OAuth library refuses to run over plain
# http, and the Flask dev server is http://localhost. Delete these two lines
# once the app is deployed behind https.
OAUTHLIB_INSECURE_TRANSPORT=1
OAUTHLIB_RELAX_TOKEN_SCOPE=1

# Encrypts stored Gmail tokens, so yums.db is useless on its own. Generate
# one with:  python -c "import encryption; print(encryption.generate_key())"
# Back it up: if this key is lost, every user has to reconnect their Gmail.
YUMS_ENCRYPTION_KEY=your-generated-key

# Where signup confirmation codes are sent from. Leave these blank and the
# codes get printed in the terminal instead, which is fine for local testing
# but must not be how it runs in production.
# For Gmail, SMTP_PASSWORD must be an App Password, not your normal one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
