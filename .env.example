# --- Needed by both the CLI (main.py) and the web app (app.py) ---
OPENAI_API_KEY=sk-your-key

# --- Web app only ---

# Any long random string. Flask signs session cookies with it, so changing
# it logs everybody out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-something-random

# From a "Web application" OAuth client in Google Cloud Console. The CLI's
# credentials.json is a Desktop client and won't work here - see the README.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Local development only. Google's OAuth library refuses to run over plain
# http, and the Flask dev server is http://localhost. Delete these two lines
# once the app is deployed behind https.
OAUTHLIB_INSECURE_TRANSPORT=1
OAUTHLIB_RELAX_TOKEN_SCOPE=1
